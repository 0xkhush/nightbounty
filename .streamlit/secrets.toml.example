# Copy this file to .streamlit/secrets.toml for local Streamlit use.
# Do not commit the copied file or any real secrets.
# Replace this example before running the app; it must be at least 12 characters.
owner_access_code = "replace-with-a-long-random-owner-code"

# Generate this once with: python3 tools/generate_owner_keypair.py
# Store ONLY the private value here. It derives the public key shown to researchers.
# Never commit, publish, or share this private key.
owner_x25519_private_key_b64 = "replace-with-generated-x25519-private-key"

# Optional verified Midnight deployment references.
# NIGHTBOUNTY_NETWORK = "PreProd"
# NIGHTBOUNTY_CONTRACT_ADDRESS = ""
# NIGHTBOUNTY_DEPLOYMENT_TX = ""
